 "rows": [
  ["Banking", "Logistic reg.", "0.842", "0.699", "0.441", "0.541", "0.831", "0.468"],
  ["Banking", "Random forest", "0.842", "0.613", "0.677", "0.644", "0.881", "0.543"],
  ["Banking", "XGBoost", "0.848", "0.624", "0.713", "0.665", "0.883", "0.570"],
  ["Streaming", "Logistic reg.", "0.892", "0.875", "0.917", "0.895", "0.966", "0.785"],
  ["Streaming", "Random forest", "0.989", "0.992", "0.986", "0.989", "0.998", "0.978"],
  ["Streaming", "XGBoost", "0.992", "0.994", "0.990", "0.992", "1.000", "0.984"],
